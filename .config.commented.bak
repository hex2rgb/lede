# Wolfssl Has Ecc25519
CONFIG_WOLFSSL_HAS_ECC25519=y
# Wolfssl Has Ecc448 (未启用)
# CONFIG_WOLFSSL_HAS_ECC448 is not set
# Wolfssl Has Openvpn
CONFIG_WOLFSSL_HAS_OPENVPN=y
# Wolfssl Alt Names
CONFIG_WOLFSSL_ALT_NAMES=y
