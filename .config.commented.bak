#
# SSL
#
# 软件包: libgnutls (未启用)
# CONFIG_PACKAGE_libgnutls is not set
# 软件包: libgnutls-dane (未启用)
# CONFIG_PACKAGE_libgnutls-dane is not set
# 软件包: libmbedtls
CONFIG_PACKAGE_libmbedtls=y
# (空行)
#
# Option details in source code: include/mbedtls/mbedtls_config.h
#
# (空行)
#
# Ciphers - unselect old or less-used ciphers to reduce binary size
#
# Mbedtls Aes C
CONFIG_MBEDTLS_AES_C=y
# Mbedtls Camellia C (未启用)
# CONFIG_MBEDTLS_CAMELLIA_C is not set
# Mbedtls Ccm C (未启用)
# CONFIG_MBEDTLS_CCM_C is not set
# Mbedtls Cmac C
CONFIG_MBEDTLS_CMAC_C=y
# Mbedtls Des C
CONFIG_MBEDTLS_DES_C=y
# Mbedtls Gcm C
CONFIG_MBEDTLS_GCM_C=y
# Mbedtls Nist Kw C
CONFIG_MBEDTLS_NIST_KW_C=y
# Mbedtls Ripemd160 C (未启用)
# CONFIG_MBEDTLS_RIPEMD160_C is not set
# Mbedtls Xtea C (未启用)
# CONFIG_MBEDTLS_XTEA_C is not set
# Mbedtls Rsa No Crt
CONFIG_MBEDTLS_RSA_NO_CRT=y
# Mbedtls Key Exchange Psk Enabled
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK_ENABLED=y
# Mbedtls Key Exchange Dhe Psk Enabled (未启用)
# CONFIG_MBEDTLS_KEY_EXCHANGE_DHE_PSK_ENABLED is not set
# Mbedtls Key Exchange Ecdhe Psk Enabled
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_PSK_ENABLED=y
# Mbedtls Key Exchange Rsa Psk Enabled (未启用)
# CONFIG_MBEDTLS_KEY_EXCHANGE_RSA_PSK_ENABLED is not set
# Mbedtls Key Exchange Rsa Enabled (未启用)
# CONFIG_MBEDTLS_KEY_EXCHANGE_RSA_ENABLED is not set
# Mbedtls Key Exchange Dhe Rsa Enabled (未启用)
# CONFIG_MBEDTLS_KEY_EXCHANGE_DHE_RSA_ENABLED is not set
# Mbedtls Key Exchange Ecdhe Rsa Enabled
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_RSA_ENABLED=y
# Mbedtls Key Exchange Ecdhe Ecdsa Enabled
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED=y
# Mbedtls Key Exchange Ecdh Ecdsa Enabled (未启用)
# CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA_ENABLED is not set
# Mbedtls Key Exchange Ecdh Rsa Enabled (未启用)
# CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_RSA_ENABLED is not set
# (空行)
#
# Curves - unselect old or less-used curves to reduce binary size
#
# Mbedtls Ecp Dp Secp192r1 Enabled (未启用)
# CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED is not set
# Mbedtls Ecp Dp Secp224r1 Enabled (未启用)
# CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED is not set
# Mbedtls Ecp Dp Secp256r1 Enabled
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
# Mbedtls Ecp Dp Secp384r1 Enabled
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=y
# Mbedtls Ecp Dp Secp521r1 Enabled (未启用)
# CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED is not set
# Mbedtls Ecp Dp Secp192k1 Enabled (未启用)
# CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED is not set
# Mbedtls Ecp Dp Secp224k1 Enabled (未启用)
# CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED is not set
# Mbedtls Ecp Dp Secp256k1 Enabled
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=y
# Mbedtls Ecp Dp Bp256r1 Enabled (未启用)
# CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED is not set
# Mbedtls Ecp Dp Bp384r1 Enabled (未启用)
# CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED is not set
# Mbedtls Ecp Dp Bp512r1 Enabled (未启用)
# CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED is not set
# Mbedtls Ecp Dp Curve25519 Enabled
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=y
# Mbedtls Ecp Dp Curve448 Enabled (未启用)
# CONFIG_MBEDTLS_ECP_DP_CURVE448_ENABLED is not set
# (空行)
#
# Build Options - unselect features to reduce binary size
#
# Mbedtls Certs C (未启用)
# CONFIG_MBEDTLS_CERTS_C is not set
# Mbedtls Cipher Mode Ofb (未启用)
# CONFIG_MBEDTLS_CIPHER_MODE_OFB is not set
# Mbedtls Cipher Mode Xts (未启用)
# CONFIG_MBEDTLS_CIPHER_MODE_XTS is not set
# Mbedtls Debug C (未启用)
# CONFIG_MBEDTLS_DEBUG_C is not set
# Mbedtls Hkdf C (未启用)
# CONFIG_MBEDTLS_HKDF_C is not set
# Mbedtls Platform C (未启用)
# CONFIG_MBEDTLS_PLATFORM_C is not set
# Mbedtls Self Test (未启用)
# CONFIG_MBEDTLS_SELF_TEST is not set
# Mbedtls Ssl Truncated Hmac (未启用)
# CONFIG_MBEDTLS_SSL_TRUNCATED_HMAC is not set
# Mbedtls Version C (未启用)
# CONFIG_MBEDTLS_VERSION_C is not set
# Mbedtls Version Features (未启用)
# CONFIG_MBEDTLS_VERSION_FEATURES is not set
# (空行)
#
# Build Options
#
# Mbedtls Entropy Force Sha256
CONFIG_MBEDTLS_ENTROPY_FORCE_SHA256=y
# Mbedtls Ssl Renegotiation (未启用)
# CONFIG_MBEDTLS_SSL_RENEGOTIATION is not set
# 软件包: libnss (未启用)
# CONFIG_PACKAGE_libnss is not set
# 软件包: libopenssl
CONFIG_PACKAGE_libopenssl=y
# (空行)
#
# Build Options
#
# Openssl Optimize Speed
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
# Openssl With Asm
CONFIG_OPENSSL_WITH_ASM=y
# Openssl With Deprecated
CONFIG_OPENSSL_WITH_DEPRECATED=y
# Openssl No Deprecated (未启用)
# CONFIG_OPENSSL_NO_DEPRECATED is not set
# Openssl With Error Messages
CONFIG_OPENSSL_WITH_ERROR_MESSAGES=y
# (空行)
#
# Protocol Support
#
# Openssl With Tls13
CONFIG_OPENSSL_WITH_TLS13=y
# Openssl With Dtls (未启用)
# CONFIG_OPENSSL_WITH_DTLS is not set
# Openssl With Npn (未启用)
# CONFIG_OPENSSL_WITH_NPN is not set
# Openssl With Srp
CONFIG_OPENSSL_WITH_SRP=y
# Openssl With Cms
CONFIG_OPENSSL_WITH_CMS=y
# (空行)
#
# Algorithm Selection
#
# Openssl With Ec2m (未启用)
# CONFIG_OPENSSL_WITH_EC2M is not set
# Openssl With Chacha Poly1305
CONFIG_OPENSSL_WITH_CHACHA_POLY1305=y
# Openssl Prefer Chacha Over Gcm
CONFIG_OPENSSL_PREFER_CHACHA_OVER_GCM=y
# Openssl With Psk
CONFIG_OPENSSL_WITH_PSK=y
# (空行)
#
# Less commonly used build options
#
# Openssl With Aria (未启用)
# CONFIG_OPENSSL_WITH_ARIA is not set
# Openssl With Camellia (未启用)
# CONFIG_OPENSSL_WITH_CAMELLIA is not set
# Openssl With Idea (未启用)
# CONFIG_OPENSSL_WITH_IDEA is not set
# Openssl With Seed (未启用)
# CONFIG_OPENSSL_WITH_SEED is not set
# Openssl With Sm234 (未启用)
# CONFIG_OPENSSL_WITH_SM234 is not set
# Openssl With Blake2 (未启用)
# CONFIG_OPENSSL_WITH_BLAKE2 is not set
# Openssl With Mdc2 (未启用)
# CONFIG_OPENSSL_WITH_MDC2 is not set
# Openssl With Whirlpool (未启用)
# CONFIG_OPENSSL_WITH_WHIRLPOOL is not set
# Openssl With Compression (未启用)
# CONFIG_OPENSSL_WITH_COMPRESSION is not set
# Openssl With Rfc3779 (未启用)
# CONFIG_OPENSSL_WITH_RFC3779 is not set
# (空行)
#
# Engine/Hardware Support
#
# Openssl Engine
CONFIG_OPENSSL_ENGINE=y
# Openssl Engine Builtin
CONFIG_OPENSSL_ENGINE_BUILTIN=y
# Openssl Engine Builtin Afalg
CONFIG_OPENSSL_ENGINE_BUILTIN_AFALG=y
# Openssl Engine Builtin Devcrypto
CONFIG_OPENSSL_ENGINE_BUILTIN_DEVCRYPTO=y
# 软件包: libopenssl-conf
CONFIG_PACKAGE_libopenssl-conf=y
# 软件包: libopenssl-devcrypto (未启用)
